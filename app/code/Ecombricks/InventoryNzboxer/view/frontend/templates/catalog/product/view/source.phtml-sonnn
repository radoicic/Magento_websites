?>
<input 
	type="hidden" 
	id="source_<?= $block->escapeHtmlAttr($selected_source) ?>"
	name="source"
	value="<?= $block->escapeHtmlAttr($selected_source) ?>"
/>

						
<script>		
require([
	'jquery',
], function($){

	<?php
		$product = $block->getProduct();
		$product_typid = $product->getTypeId();
			
		if($product_typid =="simple"){	
		if((int)$sourcedata[$block->escapeHtmlAttr($selected_source)]['qty']>0){
	?>
		$(".product-info-stock-sku .stock.available").append("<span>(<?php echo (int)$sourcedata[$block->escapeHtmlAttr($selected_source)]['qty'];?>  Piece<?php if((int)$sourcedata[$block->escapeHtmlAttr($selected_source)]['qty']>1){echo 's';}?>)</span>");
	<?php
		}else{
	?>
		$(".product-info-stock-sku .stock.available").html('<span class="label">Availability:</span><span>Out of stock</span>');
	<?php
		}
		}

	?>
	
});
</script>