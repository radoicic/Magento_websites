<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Catalog::catalog">
                    <resource id="TiDesign_Fundraiser::fundraiser"
                              title="Fundraiser"
                              translate="title"
                              sortOrder="100">
                        <resource id="TiDesign_Fundraiser::theme"
                                  title="Fundraiser Themes"
                                  translate="title"
                                  sortOrder="10"/>
                        <resource id="TiDesign_Fundraiser::campaigns"
                                  title="Fundraiser Campaigns"
                                  translate="title"
                                  sortOrder="20"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="TiDesign_Fundraiser::configuration" title="Fundraiser"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
