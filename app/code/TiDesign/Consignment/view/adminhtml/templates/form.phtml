		/* name */
		function nameCheck(){
				$("#name_check_message").remove();
				$("#name_container").removeClass("_error");
				if($("#td_name").val().length == ''){
					$("#name_check").after('<span id="name_check_message" class="admin__field-error">This field is required</span>');
					$("#name_container").addClass("_error");
					$('i#savechecking').replaceWith(erroricon);
					$('.savemask .modal-footer button').show();
					return false;
				};
				if($("#td_name").val().length <3){$("#name_check").after('<span id="name_check_message" class="admin__field-error">Minimum 3 letters</span>');$("#name_container").addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;};
				$.ajax({
					url:ajaxUrl,type:'POST',dataType: 'json',async: false,
					data: {bak:'name',name: $("#td_name").val(),id: <?php echo $data->getTdId() ?? 0 ;?>},
					success: function(result){
						if(result.status != 1){
							$("#name_container").addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();$("#name_check").after(result.message);	return false;
						}
						$('i#savechecking').replaceWith(passicon);
						setTimeout(websiteCheck, 500);
					},
					error: function (xhr, status, errorThrown) {return false;}
				});	
		};
		/* website */
		function websiteCheck(){
			$(".savecontent ul").append('<li>'+checkicon+' Checking Website</li>');
			$("#website_check_message").remove();
			$("#website_container").removeClass("_error");
			if($('#website').val()== ""){
				$('#website_container').addClass("_error");
				$("#website").after('<span id="website_check_message" class="admin__field-error">This field is required</span>');
				$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();	return false;
			}else{
				$('i#savechecking').replaceWith(passicon);
				setTimeout(categoryCheck, 500);
			}			
		}
		
		
		/* category */
		function categoryCheck(){
			$(".savecontent ul").append('<li>'+checkicon+' Checking Category</li>');
			var selected = $('input[name="category_type_selector"]:checked').val();

			$("#category_check_message").remove();
			$("#excategory_check_message").remove();
			$("#category_container").removeClass("_error");
			$('#existing_category').parent().removeClass("_error");
			
			if(selected == "category_add_option"){
				if($("#new_category").val().length == ''){$("#category_check").after('<span id="category_check_message" class="admin__field-error">This field is required</span>');$("#category_container").addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();	return false;}
				if($("#new_category").val().length <3){$("#category_check").after('<span id="category_check_message" class="admin__field-error">Minimum 3 letters</span>');$("#category_container").addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();	return false;}
				$.ajax({
					url:ajaxUrl,type:'POST',dataType:'json',async: false,
					data: {bak:'category',website: $("#website").val(),category: $("#new_category").val()},
					success: function(result){
						if(result.status != 1){
							$("#category_container").addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();$("#category_check").after(result.message);	return false;
						}
						$('i#savechecking').replaceWith(passicon);
						setTimeout(souceCheck, 500);
					},
					error: function (xhr, status, errorThrown) {return false;}
				});				
			}else{
				if($('#existing_category').val()== ""){
					$('#existing_category').parent().addClass("_error");
					$("#existing_category").after('<span id="excategory_check_message" class="admin__field-error">This field is required</span>');
					$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();	return false;
				}else{
					$('i#savechecking').replaceWith(passicon);
					setTimeout(souceCheck, 500);
				}
			}
		}
		
		/* source */
		function souceCheck(){
			$(".savecontent ul").append('<li>'+checkicon+' Checking Source</li>');
			var selected = $('input[name="source_type_selector"]:checked').val();	
			
			$("#source_check_message").remove();
			$("#exsource_check_message").remove();
			$("#source_container").find("._error").removeClass("_error");
			
			if(selected == "source_add_option"){		

				if($("#source_name").val().length == ''){$("#source_name").after('<span id="source_check_message" class="admin__field-error">This field is required</span>');$("#source_name").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}
				if($("#source_name").val().length <3){$("#source_name").after('<span id="source_check_message" class="admin__field-error">Minimum 3 letters</span>');$("#source_name").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}
				
				if($("#source_code").val().length == ''){$("#source_check").after('<span id="source_check_message" class="admin__field-error">This field is required</span>');$("#source_code").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}
				if($("#source_code").val().length <3){$("#source_check").after('<span id="source_check_message" class="admin__field-error">Minimum 3 letters</span>');$("#source_code").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}
				if($("#source_code").val().indexOf(' ')>=0){$("#source_code").after('<span id="source_check_message" class="admin__field-error">Space is not allowed!!</span>');$("#source_code").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}

				if($('#source_city').val()== ""){$('#source_city').parent().addClass("_error");$("#source_city").next().after('<span id="source_check_message" class="admin__field-error">This field is required</span>');$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;
				}
				
				if($("#source_postcode").val().length == ''){$("#source_postcode").after('<span id="source_check_message" class="admin__field-error">This field is required</span>');$("#source_postcode").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}
				if($("#source_postcode").val().length <3){$("#source_postcode").after('<span id="source_check_message" class="admin__field-error">Minimum 3 letters</span>');$("#source_postcode").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}
				$.ajax({
					url: ajaxUrl,type: 'POST',dataType: 'json',async: false,
					data: {	bak:'source',source: $("#source_code").val()},
					success: function(result){
						if(result.status != 1){
							$("#source_check").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();$("#source_check").after(result.message);	return false;
						}
						$('i#savechecking').replaceWith(passicon);
						setTimeout(customerCheck, 500);
					},
					error: function (xhr, status, errorThrown) {return false;}
				});
			}else{
				if($('#existing_source').val()== ""){
					$('#existing_source').parent().addClass("_error");
					$("#existing_source").after('<span id="exsource_check_message" class="admin__field-error">This field is required</span>');
					$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();	return false;
				}else{
					$('i#savechecking').replaceWith(passicon);
					setTimeout(customerCheck, 500);
				}
			}
		}
		/* customer */
		function customerCheck(){		
			$(".savecontent ul").append('<li>'+checkicon+' Checking Customer</li>');
			var selected = $('input[name="customer_type_selector"]:checked').val();
			
			$("#email_check_message").remove();
			$("#customer_check_message").remove();
			$("#customer_container").find("._error").removeClass("_error");
			
			if(selected == "customer_add_option"){
				if(isEmail($("#new_customer_email").val()) != true){
					$("#email_check").after('<span id="email_check_message" class="admin__field-error">Please enter valid email</span>');
					$("#email_check").parent().addClass("_error");
					$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;
				}
				if($("#new_customer_name").val().length == ''){$("#new_customer_name").after('<span id="customer_check_message" class="admin__field-error">This field is required</span>');$("#new_customer_name").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}
				if($("#new_customer_name").val().length <3){$("#new_customer_name").after('<span id="customer_check_message" class="admin__field-error">Minimum 3 letters</span>');$("#new_customer_name").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}	
				
				if($("#new_customer_surname").val().length == ''){$("#new_customer_surname").after('<span id="customer_check_message" class="admin__field-error">This field is required</span>');$("#new_customer_surname").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}
				if($("#new_customer_surname").val().length <3){$("#new_customer_surname").after('<span id="customer_check_message" class="admin__field-error">Minimum 3 letters</span>');$("#new_customer_surname").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;}				
				
				$("#new_customer_password").trigger("blur");if($("#new_customer_password").parent().hasClass("_error")){
					$("#new_customer_password").after('<span id="customer_check_message" class="admin__field-error">Please enter valid password</span>');$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();return false;
				}
				$.ajax({
					url: ajaxUrl,type: 'POST',dataType:'json',async: false,
					data: {bak:'email',email: $("#new_customer_email").val()},
					success: function(result){
						if(result.status != 1){
							$("#email_check").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();$("#email_check").after(result.message);	return false;
						}
						$('i#savechecking').replaceWith(passicon);
						setTimeout(prepareForm, 500);
					},
					error: function (xhr, status, errorThrown) {return false;}
				});
				
			}else{
				if(!$(".customer-selector:checked").length){
					$("#customer_check").parent().addClass("_error");$('i#savechecking').replaceWith(erroricon);$('.savemask .modal-footer button').show();$("#customer_check").after('<span id="customer_check_message" class="admin__field-error">Please select customer account</span>');	return false;
				}else{
					$('i#savechecking').replaceWith(passicon);
					setTimeout(prepareForm, 500);
				}
				
			}
		}
		
		function prepareForm(){
			$(".savecontent ul").append('<hr/>');
			$(".savecontent ul").append('<li>'+checkicon+' Preparing Data to save...</li>');
			$("#forms").attr("method","POST").attr('action','<?php echo $this->getUrl("consignment/consignmentlist/save");?>').submit();
		}
		
