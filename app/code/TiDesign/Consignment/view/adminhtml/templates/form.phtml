/*	********************* name_check *******************************/
		$('#td_name').keydown(function (event) {
			let keyPressed = event.keyCode || event.which;
			if (keyPressed === 13) {
				$("#name_check").trigger("click");
			}
		});
		$("#name_check").click(function(){
			$("#name_check_message").remove();
			$("#name_container").removeClass("_error");
			if($("#td_name").val().length == ''){$("#name_check").after('<span id="name_check_message" class="admin__field-error">This field is required</span>');$("#name_container").addClass("_error");return false;}
			if($("#td_name").val().length <3){$("#name_check").after('<span id="name_check_message" class="admin__field-error">Minimum 3 letters</span>');$("#name_container").addClass("_error");return false;}
			show_loader();
			$.ajax({
				url: ajaxUrl,
				type: 'POST', 
				dataType: 'json',
				async: false,
				data: {
					bak:'name',
					name: $("#td_name").val(),
					id: <?php echo $data->getTdId() ?? 0 ;?>
				},
				success: function(result){
					hide_loader();
					console.log(result);
					if(result.status != 1){
						$("#name_container").addClass("_error");
					}
					$("#name_check").after(result.message);
					$("#name_check_message").delay(5000).slideUp();
				},
				error: function (xhr, status, errorThrown) {
					hide_loader();
				}
			});
		});
