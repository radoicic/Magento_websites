<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

	<type name="TiDesign\Videobackground\Model\ImageUploader">
		<arguments>
			<argument name="baseTmpPath" xsi:type="string">label/tmp/image</argument>
			<argument name="basePath" xsi:type="string">label/image</argument>
			<argument name="allowedExtensions" xsi:type="array">
				<item name="mp4" xsi:type="string">mp4</item>
				<item name="webm" xsi:type="string">webm</item>
			</argument>
		</arguments>
	</type>


	<preference for="TiDesign\Videobackground\Api\Data\VideolistInterface" type="TiDesign\Videobackground\Model\Videolist" />
	<preference for="TiDesign\Videobackground\Api\VideolistRepositoryInterface" type="TiDesign\Videobackground\Model\VideolistRepository" />

	<virtualType name="VideolistGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="collection" xsi:type="object" shared="false">TiDesign\Videobackground\Model\ResourceModel\Videolist\Collection</argument>
        </arguments>
    </virtualType>

	<type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
		<arguments>
			<argument name="collections" xsi:type="array">
				<item name="tidesign_videobackground_grid_data_source" xsi:type="string">TiDesign\Videobackground\Model\ResourceModel\Videolist\Grid\Collection</item>
			</argument>
		</arguments>
	</type>	
	<virtualType name="TiDesign\Videobackground\Model\ResourceModel\Videolist\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
		<arguments>
			<argument name="mainTable" xsi:type="string">tidesign_videobackground</argument>
			<argument name="resourceModel" xsi:type="string">TiDesign\Videobackground\Model\ResourceModel\Videolist</argument>
		</arguments>
	</virtualType>
	<type name="Magento\Framework\Model\Entity\RepositoryFactory">
        <arguments>
            <argument name="entities" xsi:type="array">
                <item name="TiDesign\Videobackground\Api\Data\VideolistInterface" xsi:type="string">TiDesign\Videobackground\Api\VideolistRepositoryInterface</item>
            </argument>
        </arguments>
    </type>	

 

