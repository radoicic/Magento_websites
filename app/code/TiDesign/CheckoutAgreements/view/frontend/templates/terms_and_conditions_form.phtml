<script>
	require([
	  'jquery',
	], function($){
		$(document).ready(function() {
			$(document).on("click", '.read-more-button', function(event){
				event.preventDefault();
				$(this).parent().toggleClass("open");
				return false;
			});
			$(document).on("click", 'a[href="#readmore"]', function(event){
				event.preventDefault();
				$('.read-more-button').click();
				return false;
			});			
		});
	});	
</script>	

