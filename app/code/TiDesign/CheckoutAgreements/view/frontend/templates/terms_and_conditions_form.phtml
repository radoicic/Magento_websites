<script>
	require([
	  'jquery',
	  'Magento_Ui/js/modal/alert',
	  'loader'
	], function($,alert){
		$(document).ready(function() {
			var ajaxUrl = "<?php echo $this->getUrl('termsandconditions/ajax');?>"; 
			function show_loader(){$("body").loader("show");}
			function hide_loader(){$("body").loader("hide");}
					
			$(document).on("click", '.download-button', function(event){
				var link = document.createElement('a');
				link.href = '<?php echo $block->getDownloadUrl($filename);?>';
				link.download = '<?php echo $filename;?>';
				link.dispatchEvent(new MouseEvent('click'));
				document.body.removeChild(link);
			});
			
			$(document).on("click", '.edit-button:not(.disabled)', function(event){
				var el = $(this);
				show_loader();
				$.ajax({
					url: ajaxUrl,
					type: 'POST', 
					dataType: 'json',
					async: false,
					data: {
						islem: 'requestedit',
						customerid: '<?=$block->getCutomerId();?>',
						ip: '<?=$block->getCustomerIp();?>',
					},
					success: function(result){
						hide_loader();
						console.log(result);
						if(result.status != 1){
							alert({content: "Error"});
						}
						el.addClass("disabled");
						alert({content: result.html});

					},
					error: function (xhr, status, errorThrown) {
						hide_loader();
						alert({content: "Error"});
					}
				});	

			});				
			
		});
	});
</script>			
<?php
